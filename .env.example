# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Only EXPO_PUBLIC_* variables reach the app, and everything that reaches the
# app SHIPS INSIDE THE BUNDLE — anyone who downloads it can read these values.
#
# That is fine for the two Supabase values below. The anon key is designed to be
# public; what protects your data is Row Level Security on the database, not the
# secrecy of that key.
#
# It is NOT fine for a Supabase SERVICE ROLE key, which bypasses RLS entirely.
# If one ever appears in a .env for this app, treat it as leaked and rotate it.

# Leave both blank to run against the in-memory repositories — the app works
# fully with no backend account at all.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# Skip the sign-in screen and start on the main tabs, against in-memory data.
#
# MOSTLY OBSOLETE NOW. The sign-in screen offers real sign-up, sign-in and
# password reset with an email and password, so getting into the app no longer
# requires this — make an account on the first screen instead. It remains for
# working on a screen with no network at all.
#
# It forces the in-memory repositories even when the Supabase values above are
# filled in, because Row Level Security requires a real authenticated caller: a
# fake session against the real database returns nothing from every table. So
# LEAVE THIS BLANK if you want to see real data.
#
# Ignored entirely when EXPO_PUBLIC_ENVIRONMENT=production, so it cannot ship
# enabled.
EXPO_PUBLIC_DEV_SKIP_AUTH=

# Show "Continue with Google" on the sign-in screen.
#
# Blank or false until BOTH exist: an OAuth client in Google Cloud, and the
# Google provider enabled in the Supabase dashboard. Until then the button
# returns "Unsupported provider: provider is not enabled" — an error on the
# first screen of the app that the member can do nothing about, which is worse
# than not offering it. See project-setup.md section 6a.
#
# Also required before turning it on: the app's callback listed in Supabase ->
# Authentication -> URL Configuration -> Redirect URLs — offtexts://auth/callback
# for installed builds and for iPhones (Expo Go included), plus — for Expo Go on
# Android only — the exp://…/--/auth/callback address the app logs at startup. A callback that is not listed sends the new
# session to the Site URL instead of back to the app. For EAS builds, set this
# variable in the EAS environment, not here.
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=

# One-tap "Demo sign-in" button on the first screen. Development only.
#
# READ THIS BEFORE FILLING IT IN. These two values ship inside the bundle and
# are readable by anyone who downloads the app. The password here may only ever
# belong to a THROWAWAY TEST ACCOUNT created for this purpose — never a real
# member's, never an account with staff access, and never a password used
# anywhere else. Treat it as public the moment you write it down.
#
# It exists because sign-in is being built separately and everything past the
# auth gate needs a real session. Unlike EXPO_PUBLIC_DEV_SKIP_AUTH above, this
# signs in properly: real session, real Row Level Security, real rows — which
# is the whole point of it.
#
# The button only appears when BOTH are set, Supabase is configured, and
# EXPO_PUBLIC_ENVIRONMENT is not production. It cannot ship enabled.
#
# To create the account: Supabase dashboard -> Authentication -> Users -> Add
# user, with "Auto Confirm User" ticked.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=

# Seconds the "Send a new code" button waits after a verification email.
#
# Copy it from the Supabase Dashboard — the per-member minimum interval between
# emails (Authentication -> Emails -> SMTP Settings when custom SMTP is on). Do
# not invent one: a number shorter than the real setting shows a button that
# the server then refuses.
#
# Leave blank if you do not have the figure. The app then waits only when
# Supabase refuses a resend, for as long as Supabase says.
EXPO_PUBLIC_AUTH_RESEND_COOLDOWN_SECONDS=

# The characters a password must contain. Copy it from the Supabase Dashboard:
# Authentication -> Sign In / Providers -> Email -> Password requirements.
#
#   (blank)                              No required characters
#   letters_digits                       Letters and digits
#   lower_upper_letters_digits           Lowercase, uppercase letters and digits
#   lower_upper_letters_digits_symbols   Lowercase, uppercase letters, digits and symbols
#
# The sign-up form lists these rules as the member types. If this does not match
# the dashboard, the form will promise one thing and the server enforce another.
EXPO_PUBLIC_AUTH_PASSWORD_REQUIREMENTS=

# Sentry DSN. Public by design: it can submit events, not read them.
EXPO_PUBLIC_SENTRY_DSN=

# true | false
EXPO_PUBLIC_ENABLE_ANALYTICS=false
