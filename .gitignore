# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native builds. Regenerated by `expo prebuild`; committing them means every
# config change has to be made twice.
/ios
/android
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Environment. `.env.example` is committed; a real `.env` never is.
.env
.env.*
!.env.example

# Metro / build output
.metro-health-check*
*.tsbuildinfo
coverage/

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Editors and OS
#
# Editor settings stay local. `.editorconfig` is committed and is enough to keep
# indentation, charset and line endings consistent for everyone, whatever editor
# they use; beyond that, nobody's editor configuration belongs to the project.
.DS_Store
*.pem
.idea/
.vscode/

# Supabase CLI local state — which project this machine is linked to, pooler
# URLs, cached version stamps. Written by `supabase link`, different on every
# machine, and of no use to anyone else.
supabase/.temp/

# Jest
coverage/

# Design references — kept on disk so Claude Code can read them, never
# committed. These are screenshots of another company's app; they are a working
# reference, not ours to redistribute.
docs/design/breeze-reference/

# The Offtexts scheduling mockups are ours, so they DO belong in the repo.
# docs/design/offtexts-flow/ is intentionally not ignored.
